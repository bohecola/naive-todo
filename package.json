{
  "name": "naive-todo",
  "version": "0.1.14",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "prepare": "husky",
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "bump --commit --tag --push --all --no-verify",
    "version": "npm run changelog",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "^5.11.2",
    "nanoid": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "react-router-dom": "^7.0.0",
    "swr": "^2.2.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint-react/eslint-plugin": "^5.20.8",
    "@jsdevtools/version-bump-prompt": "^6.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.3.0",
    "cz-customizable": "^7.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "husky": "^9.0.0",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "lint-staged": {
    "*.{js,ts,mts,cts,jsx,tsx}": [
      "eslint"
    ]
  }
}
